# Application
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=data
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/output
TEMPLATE_PATH=templates/job_card_template.xlsx
FRONTEND_DIST=frontend/dist
MAX_PDF_BYTES=20971520
SEARCH_TOP_K=12
STRICT_CITATIONS=true
TEMPLATE_TASK_CAPACITY=40
REASONING_SEED=42

# Azure AI Search (Serverless Developer preview or Dedicated)
AZURE_SEARCH_ENDPOINT=https://gptkb-q6f7jlnpp6tnk.search.windows.net
AZURE_SEARCH_INDEX_NAME=job-card-reference
# Leave blank to use DefaultAzureCredential / az login.
AZURE_SEARCH_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-AOAI-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Leave blank to use DefaultAzureCredential / az login.
AZURE_OPENAI_API_KEY=
